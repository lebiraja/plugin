# Optional: Dockerfile to pre-load Ollama model
FROM ollama/ollama:latest

# Copy model initialization script
COPY ./scripts/init-ollama.sh /init-ollama.sh

RUN chmod +x /init-ollama.sh

# Pre-pull the gemma3:1b model during build
# Note: This will significantly increase build time and image size
# Uncomment the lines below if you want the model pre-loaded in the image
# RUN /init-ollama.sh

ENTRYPOINT ["/bin/sh"]
CMD [""]
