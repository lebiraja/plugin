# ─────────────────────────────────────────────────────────────────────────────
# plugin-chat — environment configuration
# Copy to `.env` and adjust. Bare-metal defaults point at localhost; Docker
# Compose overrides these to the service names (ollama, mongodb, backend).
# ─────────────────────────────────────────────────────────────────────────────

# ── Local LLM backends ───────────────────────────────────────────────────────
# Ollama inference server. In Docker this is http://ollama:11434
OLLAMA_URL=http://localhost:11434
# LM Studio (optional alternative backend)
LMSTUDIO_URL=http://localhost:1234

# ── Cloud providers ──────────────────────────────────────────────────────────
# Provider API keys are normally added at runtime via the Settings UI and stored
# ENCRYPTED in MongoDB. ENCRYPTION_KEY is the Fernet key used for that encryption
# — REQUIRED to add cloud providers. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Optional bootstrap keys: if set, they're seeded (encrypted) into the providers
# collection on first startup so a deploy ships with cloud access pre-configured.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=

# ── Web search (optional) ────────────────────────────────────────────────────
# Serper.dev API key. If unset, search falls back to DuckDuckGo.
SERPER_API_KEY=

# ── MongoDB ──────────────────────────────────────────────────────────────────
# In Docker: mongodb://admin:password@mongodb:27017/
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=plugin_chat_db

# ── Vector store / uploads ───────────────────────────────────────────────────
VECTOR_DB_PATH=./vector_db
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10 MB, in bytes

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=2000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3100

# ── Frontend (build-time) ────────────────────────────────────────────────────
# Base URL the frontend uses to reach the API. Leave as /api to use the nginx
# reverse proxy (recommended for Docker + production). Set to an absolute URL
# only when the frontend cannot proxy to the backend.
VITE_API_URL=/api
