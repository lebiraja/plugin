# ── Build stage ──────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Base URL baked into the build. Defaults to /api so the nginx reverse proxy
# (see nginx.conf) forwards API calls to the backend — no CORS, no hardcoded host.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

COPY package.json package-lock.json* yarn.lock* ./
RUN npm ci || npm install

COPY src/ src/
COPY index.html vite.config.ts tsconfig.json tsconfig.node.json postcss.config.js tailwind.config.js components.json ./

RUN npm run build

# ── Production stage (nginx) ─────────────────────────────────────────────────
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost/ -o /dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
